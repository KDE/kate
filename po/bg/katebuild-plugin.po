#: TargetHtmlDelegate.cpp:95
#, kde-format
msgid ""
"Leave empty to use the directory of the current document.\n"
"Add search directories by adding paths separated by ';'"
msgstr ""
"Оставете празно, за да се използва директорията на текущия документ.\n"
"Добавяне на директории за търсене чрез добавяне на пътища, разделени със ';'"

#: TargetHtmlDelegate.cpp:102
#, kde-format
msgid ""
"Use:\n"
"\"%B\" for project base directory\n"
"\"%b\" for name of project base directory"
msgstr ""
"Употреба:\n"
"\"%B\" за базова директория на проекта\n"
"\"%b\" за името на базовата директория на проекта"

#: TargetHtmlDelegate.cpp:106
#, kde-format
msgid ""
"Use:\n"
"\"%f\" for current file\n"
"\"%d\" for directory of current file\n"
"\"%n\" for current file name without suffix\n"
"\"%B\" for current project's base directory\n"
"\"%w\" for the working directory of the target"
msgstr ""
"Използване:\n"
"\"%f\" за текущ файл\n"
"\"%d\" за директория на текущия файл\n"
"\"%n\" за име на текущия файл без разширение\n"
"\"%B\" за базова директория на текущия проект\n"
"\"%w\" за работна директория на целта"

