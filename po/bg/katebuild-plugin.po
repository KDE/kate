msgstr "Грешка при създаването на директорията <b>%1</b>"

#: plugin_katebuild.cpp:880
#, kde-format
msgid "Failed to run \"%1\". exitStatus = %2"
msgstr "Грешка при изпълнение на \"%1\". exitStatus = %2"

#: plugin_katebuild.cpp:896
#, kde-format
msgid "Building <b>%1: %2</b> cancelled"
msgstr "Прекъсване на изграждането на <b>%1: %2</b>"

