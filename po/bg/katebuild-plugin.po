msgstr "Не е намерена команда за компилиране на файл \"%1\" в \"%2\". "

#: plugin_katebuild.cpp:1034
#, kde-format
msgid ""
"Cannot make \"%f\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Невъзможно е заместването на \"%f\". Няма отворен файл или текущият файл е "
"безименен!"

#: plugin_katebuild.cpp:1038
#, kde-format
msgid ""
"Cannot make \"%d\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Невъзможно е заместването на \"%d\". Няма отворен файл или текущият файл е "
"безименен!"

#: plugin_katebuild.cpp:1042
#, kde-format
msgid ""
"Cannot make \"%n\" substitution. No open file or the current file is "
"untitled!"
