#: deploymentconfig.cpp:108
#, kde-format
msgid "deployment must be an object"
msgstr "разгръщането трябва да бъде обект"

#: deploymentconfig.cpp:123
#, kde-format
msgid "deployment host must not be empty"
msgstr "Хостът за разгръщане не трябва да бъде празен"

#: deploymentconfig.cpp:126 deploymentconfig.cpp:130 deploymentconfig.cpp:193
#, kde-format
msgid "deployment host is invalid"
msgstr "Хостът за разгръщане е невалиден"

#: deploymentconfig.cpp:139
#, kde-format
msgid "deployment port must be between 1 and 65535"
msgstr "портът за разгръщане трябва да бъде между 1 и 65535"

#: deploymentconfig.cpp:145
#, kde-format
msgid "project base must not be empty"
msgstr "базата на проекта не трябва да бъде празна"

#: deploymentconfig.cpp:150
#, kde-format
msgid "project base must be an existing directory"
msgstr "базата на проекта трябва да бъде съществуваща директория"

#: deploymentconfig.cpp:157
#, kde-format
msgid "deployment localRoot must not contain traversal"
msgstr "Локалният корен на разгръщането не трябва да съдържа traversal"

#: deploymentconfig.cpp:165
#, kde-format
msgid ""
"deployment localRoot must be an existing directory inside the project base"
msgstr ""
"локалният корен (localRoot) на разгръщането трябва да бъде съществуваща "
"директория в основната папка на проекта"

#: deploymentconfig.cpp:170
#, kde-format
msgid "deployment remoteRoot must be an absolute path without traversal"
msgstr ""
"дистанционният корен (remoteRoot) на разгръщането трябва да бъде абсолютен "
"път без обхождане на директории (traversal)"

#: deploymentconfig.cpp:182
#, kde-format
msgid "deployment exclude entries must be strings"
msgstr "записите за изключване при разгръщане трябва да бъдат низове"

#: deploymentconfig.cpp:187
#, kde-format
msgid "deployment exclude must be a list of strings"
msgstr "Изключванията при разгръщане трябва да бъдат списък от низове"

