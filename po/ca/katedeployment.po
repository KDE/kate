#: deploymentplugin.cpp:533
#, kde-format
msgid "Open or select a Kate project before configuring deployment."
msgstr ""
"Obriu o seleccioneu un projecte del Kate abans de configurar el desplegament."

#: deploymentplugin.cpp:537
#, kde-format
msgid ""
"Deployment configuration requires a file-backed <filename>.kateproject</"
"filename>."
msgstr ""
"La configuració de desplegament requereix un fitxer <filename>.kateproject</"
"filename>."

#: deploymentplugin.cpp:553
#, kde-format
msgid "Could not read <filename>%1</filename>."
msgstr "No s'ha pogut llegir <filename>%1</filename>."

#: deploymentplugin.cpp:561
#, kde-format
msgid "Could not update malformed JSON in <filename>%1</filename>: %2"
msgstr ""
"No s'ha pogut actualitzar el JSON amb format incorrecte a <filename>%1</"
"filename>: %2"

#: deploymentplugin.cpp:574
#, kde-format
msgid "Could not write <filename>%1</filename>."
msgstr "No s'ha pogut escriure a <filename>%1</filename>."

#: deploymentplugin.cpp:581
#, kde-format
msgid "Saved deployment configuration to %1"
msgstr "S'ha desat la configuració de desplegament a %1"

#: deploymentplugin.cpp:595
#, kde-format
msgid "The current document is not a local file."
msgstr "El document actual no és un fitxer local."

#: deploymentplugin.cpp:631
#, kde-format
msgid "The file could not be saved before upload."
msgstr "No s'ha pogut desar el fitxer abans de pujar-lo."

#: deploymentplugin.cpp:646
#, kde-format
msgid "Deployment is not configured for this project."
msgstr "El desplegament no està configurat per a aquest projecte."

#: deploymentplugin.cpp:651
#, kde-format
msgid "A deployment transfer is already running."
msgstr "Ja s'està executant una transferència de desplegament."

#: deploymentplugin.cpp:661
#, kde-format
msgid "Cannot upload %1 because its remote version is open in Kate."
msgstr ""
"No s'ha pogut pujar %1 perquè la seva versió remota està oberta al Kate."

#: deploymentplugin.cpp:672
#, kde-format
msgid "No deployable files were selected."
msgstr "No s'ha seleccionat cap fitxer desplegable."

#: deploymentplugin.cpp:678
#, kde-format
msgid "Queued one file for upload."
msgid_plural "Queued %1 files for upload."
msgstr[0] "S'ha enviat un fitxer a la cua per pujar-lo."
msgstr[1] "S'han enviat %1 fitxers a la cua per pujar-los."

#: deploymentplugin.cpp:696 deploymentplugin.cpp:762
#, kde-format
msgid "The remote file is open in Kate."
msgstr "El fitxer remot està obert al Kate."

#: deploymentplugin.cpp:706
#, kde-format
msgid "Uploading %1 to %2"
msgstr "S'està pujant %1 a %2"

#: deploymentplugin.cpp:744
#, kde-format
msgctxt "@action"
msgid "Cancel Deployment Transfers (%1%)"
msgstr "Cancel·la les transferències de desplegament (%1%)"

#: deploymentplugin.cpp:785
#, kde-format
msgid "Failed to upload %1: %2"
msgstr "Ha fallat en pujar %1: %2"

#: deploymentplugin.cpp:787
#, kde-format
msgid "Uploaded %1"
msgstr "S'ha pujat %1"

#: deploymentplugin.cpp:807
#, kde-format
msgid "Cancelled deployment transfers."
msgstr "Transferències de desplegament cancel·lades."

#: deploymentplugin.cpp:839
#, kde-format
msgid "Not connected"
msgstr "No connectat"

#: deploymentplugin.cpp:856
#, kde-format
msgid ""
"The SFTP KIO worker is not installed or does not support directory listing."
msgstr ""
"El procés de treball KIO SFTP no està instal·lat o no permet el llistat de "
"directoris."

