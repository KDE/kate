#: plugin_katebuild.cpp:1036
#, kde-format
msgid ""
"Cannot make \"%f\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Kan ikke lave en \"%f\" erstatning. Ingen åbne filer, eller den nuværende "
"fil er uden navn!"

#: plugin_katebuild.cpp:1040
#, kde-format
msgid ""
"Cannot make \"%d\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Kan ikke lave en \"%d\" erstatning. Ingen åbne filer, eller den nuværende "
"fil er uden navn!"

#: plugin_katebuild.cpp:1044
#, kde-format
msgid ""
"Cannot make \"%n\" substitution. No open file or the current file is "
"untitled!"
