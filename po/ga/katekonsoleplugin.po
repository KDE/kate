#: kateconsole.cpp:123 kateconsole.cpp:155 kateconsole.cpp:796
#, kde-format
msgid "Terminal"
msgstr "Teirminéal"

#: kateconsole.cpp:164
#, kde-format
msgctxt "@action"
msgid "&Pipe to Terminal"
msgstr "&Píopáil go Teirminéal"

#: kateconsole.cpp:168
#, kde-format
msgctxt "@action"
msgid "S&ynchronize Terminal with Current Document"
msgstr "S&ioncrónaigh an Teirminéal leis an gCáipéis Reatha"

#: kateconsole.cpp:172
#, kde-format
msgctxt "@action"
msgid "Run Current Document"
msgstr "Rith an Doiciméad Reatha"

#: kateconsole.cpp:177 kateconsole.cpp:580
#, kde-format
msgctxt "@action"
msgid "S&how Terminal Panel"
msgstr "Tais&peáin Painéal Teirminéal"

#: kateconsole.cpp:183
#, kde-format
msgctxt "@action"
msgid "&Focus Terminal Panel"
msgstr "Painéal Teirminéal &Fócais"

#: kateconsole.cpp:189
#, kde-format
msgctxt "@action"
msgid "&Split Terminal Vertically"
msgstr "&Scoilt an Teirminéal go hIngearach"

#: kateconsole.cpp:194
#, kde-format
msgctxt "@action"
msgid "&Split Terminal Horizontally"
msgstr "&Scoilt an Teirminéal go Cothrománach"

#: kateconsole.cpp:199
#, kde-format
msgctxt "@action"
msgid "&New Terminal Tab"
msgstr "Cluaisín Teirminéal Nua"

#: kateconsole.cpp:363
#, kde-format
msgid ""
"Konsole not installed. Please install konsole to be able to use the terminal."
msgstr ""
"Níl Konsole suiteáilte. Suiteáil konsole le go mbeidh tú in ann an "
"críochfort a úsáid."

#: kateconsole.cpp:439
#, kde-format
msgid ""
"Do you really want to pipe the text to the console? This will execute any "
"contained commands with your user rights."
msgstr ""
"An bhfuil tú cinnte gur mian leat an téacs a phíopáil go dtí an consól? "
"Rithfear aon orduithe atá sa téacs ar a bhfuil go leor ceadanna agat."

#: kateconsole.cpp:440
#, kde-format
msgid "Pipe to Terminal?"
msgstr "Píopáil go dtí an Teirminéal?"

#: kateconsole.cpp:441
#, kde-format
msgid "Pipe to Terminal"
msgstr "Píopáil go dtí an Teirminéal"

#: kateconsole.cpp:509
#, kde-format
msgid "Not a local file: '%1'"
msgstr "Ní comhad áitiúil é: '%1'"

#: kateconsole.cpp:542
#, kde-format
msgid ""
"Do you really want to Run the document ?\n"
"This will execute the following command,\n"
"with your user rights, in the terminal:\n"
"'%1'"
msgstr ""
"An bhfuil tú cinnte gur mian leat an doiciméad a rith?\n"
"Déanfaidh sé seo an t-ordú seo a leanas a fhorghníomhú,\n"
"le do chearta úsáideora, sa chríochfort:\n"
"'%1'"

#: kateconsole.cpp:549
#, kde-format
msgid "Run in Terminal?"
msgstr "Rith sa Teirminéal?"

#: kateconsole.cpp:550
#, kde-format
msgid "Run"
msgstr "Rith"

#: kateconsole.cpp:582
#, kde-format
msgctxt "@action"
msgid "&Hide Terminal Panel"
msgstr "Folaigh &Painéal Teirminéal"

#: kateconsole.cpp:590
#, kde-format
msgid "Defocus Terminal Panel"
msgstr "Painéal Teirminéal Dífhócais"

#: kateconsole.cpp:591 kateconsole.cpp:592
#, kde-format
msgid "Focus Terminal Panel"
msgstr "Painéal Teirminéil Fócas"

#: kateconsole.cpp:704
#, kde-format
msgid "Terminal Synchronization Mode"
msgstr "Mód Sioncrónaithe Críochfoirt"

#: kateconsole.cpp:707
#, kde-format
msgid "&Don't synchronize terminal tab with current document"
msgstr "Ná sioncrónaigh an cluaisín teirminéal leis an &doiciméad reatha"

#: kateconsole.cpp:710
#, kde-format
msgid ""
"&Automatically synchronize the current terminal tab with the current "
"document when possible"
msgstr ""
"Sioncrónaigh an cluaisín teirminéal reatha leis &an doiciméad reatha go "
"huathoibríoch nuair is féidir"

#: kateconsole.cpp:713
#, kde-format
msgid ""
"&Automatically create a terminal tab for the directory of the current "
"document and switch to it"
msgstr ""
"Cruthaigh clu&aisín teirminéal go huathoibríoch don eolaire den doiciméad "
"reatha agus aistrigh chuige"

#: kateconsole.cpp:720 kateconsole.cpp:741
#, kde-format
msgid "Run in terminal"
msgstr "Rith sa teirminéal"

#: kateconsole.cpp:722
#, kde-format
msgid "&Remove extension"
msgstr "&Bain síneadh"

#: kateconsole.cpp:727
#, kde-format
msgid "Prefix:"
msgstr "Réimír:"

#: kateconsole.cpp:735
#, kde-format
msgid "&Show warning next time"
msgstr "&Taispeáin rabhadh an chéad uair eile"

#: kateconsole.cpp:737
#, kde-format
msgid ""
"The next time '%1' is executed, make sure a warning window will pop up, "
"displaying the command to be sent to terminal, for review."
msgstr ""
"An chéad uair eile a fhorghníomhófar '%1', déan cinnte go dtiocfaidh "
"fuinneog rabhaidh aníos, ag taispeáint an ordaithe atá le seoladh chuig an "
"teirminéal, le haghaidh athbhreithnithe."

#: kateconsole.cpp:748
#, kde-format
msgid "Set &EDITOR environment variable to 'kate -b'"
msgstr "Úsáid 'kate -b' mar athróg thimpeallachta &EDITOR"

#: kateconsole.cpp:751
#, kde-format
msgid ""
"Important: The document has to be closed to make the console application "
"continue"
msgstr ""
"Tábhachtach: Ní mór an cháipéis a dhúnadh sular féidir dul ar aghaidh leis "
"an bhfeidhmchlár consóil"

#: kateconsole.cpp:754
#, kde-format
msgid "Hide Konsole on pressing 'Esc'"
msgstr "Folaigh Konsole nuair a bhrúnn tú 'Esc'"

#: kateconsole.cpp:757
#, kde-format
msgid ""
"This may cause issues with terminal apps that use Esc key, for e.g., vim. "
"Add these apps in the input below (Comma separated list)"
msgstr ""
"D’fhéadfadh sé seo fadhbanna a chruthú le haipeanna críochfoirt a úsáideann "
"an eochair Esc, mar shampla, vim. Cuir na haipeanna seo leis an ionchur "
"thíos (liosta scartha le camóga)"

#: kateconsole.cpp:801
#, kde-format
msgid "Terminal Settings"
msgstr "Socruithe Teirminéil"

#. i18n: ectx: Menu (tools)
#: ui.rc:6
#, kde-format
msgid "&Tools"
msgstr "&Uirlisí"
