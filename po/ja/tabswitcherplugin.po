#: tabswitcher.cpp:57
#, kde-format
msgid "Document Switcher"
msgstr "ドキュメントスイッチャー"

#: tabswitcher.cpp:102
#, kde-format
msgid "Last Used Views"
msgstr "最後に使用したビュー"

#: tabswitcher.cpp:105
#, kde-format
msgid "Opens a list to walk through the list of last used views."
msgstr "最後に使用したビューの一覧を開いて切り替えます。"

#: tabswitcher.cpp:106 tabswitcher.cpp:114
#, kde-format
msgid "Walk through the list of last used views"
msgstr "最後に使用したビューの一覧を順に切り替え"

#: tabswitcher.cpp:110
#, kde-format
msgid "Last Used Views (Reverse)"
msgstr "最後に使用したビュー (逆順)"

#: tabswitcher.cpp:113
#, kde-format
msgid "Opens a list to walk through the list of last used views in reverse."
msgstr "最後に使用したビューの一覧を逆順で開いて切り替えます。"

#: tabswitcher.cpp:118
#, kde-format
msgid "Close View"
msgstr "ビューを閉じる"

#: tabswitcher.cpp:121 tabswitcher.cpp:122
#, kde-format
msgid "Closes the selected view in the list of last used views."
msgstr "最後に使用したビューの一覧で選択されたビューを閉じます。"

