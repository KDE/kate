#: deploymentplugin.cpp:254
#, kde-format
msgid "Remote Host"
msgstr "დაშორებული ჰოსტი"

#: deploymentplugin.cpp:280
#, kde-format
msgctxt "@action"
msgid "Deployment Root"
msgstr "განლაგების ძირითადი საქაღალდე"

#: deploymentplugin.cpp:293
#, kde-format
msgid "File Transfer"
msgstr "ფაილის მიმოცვლა"

#: deploymentplugin.cpp:301
#, kde-format
