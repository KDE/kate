#: deploymentconfig.cpp:108
#, kde-format
msgid "deployment must be an object"
msgstr "განლაგება ობიექტი უნდა იყოს"

#: deploymentconfig.cpp:123
#, kde-format
msgid "deployment host must not be empty"
msgstr "განლაგება ცარიელი უნდა იყოს"

#: deploymentconfig.cpp:126 deploymentconfig.cpp:130 deploymentconfig.cpp:193
#, kde-format
msgid "deployment host is invalid"
msgstr "განლაგების ჰოსტი არასწორია"

#: deploymentconfig.cpp:139
#, kde-format
msgid "deployment port must be between 1 and 65535"
msgstr "განლაგების პორტი უნდა იყოს შუალედიდან 1-65535"

#: deploymentconfig.cpp:145
#, kde-format
msgid "project base must not be empty"
msgstr "პროექტის ბაზა ცარიელი არ უნდა იყოს"

#: deploymentconfig.cpp:150
#, kde-format
msgid "project base must be an existing directory"
msgstr "პროექტის ბაზა არსებულ საქაღალდეს უნდა წარმოადგენდეს"

#: deploymentconfig.cpp:157
#, kde-format
msgid "deployment localRoot must not contain traversal"
msgstr "განლაგების localRoot გავლას არ უნდა შეიცავდეს"

#: deploymentconfig.cpp:165
#, kde-format
msgid ""
"deployment localRoot must be an existing directory inside the project base"
msgstr ""
"განლაგების localroot პროექტის ბაზის შიგნით არსებულ საქაღალდეს უნდა "
"წარმოადგენდეს"

#: deploymentconfig.cpp:170
#, kde-format
msgid "deployment remoteRoot must be an absolute path without traversal"
msgstr "განლაგების remoteRoot აბსოლუტური ბილიკი უნდა იყოს გავლის გარეშე"

#: deploymentconfig.cpp:182
#, kde-format
msgid "deployment exclude entries must be strings"
msgstr "განლაგებიდან ამოღებული ჩანაწერები სტრიქონებს უნდა წარმოადგენდნენ"

#: deploymentconfig.cpp:187
#, kde-format
msgid "deployment exclude must be a list of strings"
msgstr "განლაგებიდან ამოღებულები სტრიქონის სიებს უნდა წარმოადგენდნენ"

#: deploymentplugin.cpp:115
#, kde-format
msgctxt "@title:window"
msgid "Configure Deployment"
msgstr "განლაგების მორგება"

#: deploymentplugin.cpp:119
#, kde-format
msgid ""
"Configure the SFTP destination for <filename>%1</filename>. Authentication "
"is handled by KIO."
msgstr ""
"მოირგეთ SFTP სამიზნე ფაილისთვის <filename>%1</filename>. ავთენტიკაციას "
"ახორციელებს KIO."

#: deploymentplugin.cpp:136
#, kde-format
msgid "One project-relative glob per line"
msgstr "ერთი პროექტთან დაკავშირებული გლობი თითო ხაზზე"

