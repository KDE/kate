#: deploymentplugin.cpp:467
#, kde-format
msgid "Open or select a Kate project before configuring deployment."
msgstr "განლაგების მორგებამდე გახსენით, ან აირჩიეთ Kate-ის პროექტი."

#: deploymentplugin.cpp:472
#, kde-format
msgid ""
"Deployment configuration requires a file-backed <filename>.kateproject</"
"filename>."
msgstr ""
"განლაგების მორგებას სჭირდება ფაილში არწერილი <filename>.kateproject</"
"filename>."

#: deploymentplugin.cpp:487
#, kde-format
msgid "Could not read <filename>%1</filename>."
msgstr "<filename>%1</filename>-ის წაკითხვის შეცდომა."

#: deploymentplugin.cpp:493
#, kde-format
msgid "Could not update malformed JSON in <filename>%1</filename>: %2"
msgstr ""
"არასწორად ჩამოყალიბებული JSON-ის განახლება ფაილში <filename>%1</filename> "
"შეუძლებელია: %2"

#: deploymentplugin.cpp:502
#, kde-format
msgid "Could not write <filename>%1</filename>."
msgstr "ჩაწერის შეცდომა ფაილისთვის <filename>%1</filename>."

#: deploymentplugin.cpp:508
#, kde-format
msgid "Saved deployment configuration to %1"
msgstr "განლაგების კონფიგურაცია შენახულია ფაილში %1"

#: deploymentplugin.cpp:520
#, kde-format
msgid "The current document is not a local file."
msgstr "მიმდინარე დოკუმენტი ლოკალური ფაილი არაა."

#: deploymentplugin.cpp:555
#, kde-format
msgid "The file could not be saved before upload."
msgstr "ატვირთვამდე ფაილის შენახვა შეუძლებელია."

#: deploymentplugin.cpp:571
#, kde-format
msgid "Deployment is not configured for this project."
msgstr "ამ პროექტისთვის განლაგება მორგებული არაა."

#: deploymentplugin.cpp:575
#, kde-format
msgid "A deployment transfer is already running."
msgstr "განლაგების გადაცემა უკვე გაშვებულია."

#: deploymentplugin.cpp:586
#, kde-format
msgid "Cannot upload %1 because its remote version is open in Kate."
msgstr ""
"%1-ის ატვირთვა შეუძლებელია, რადგან მისი დაშორებული ვერსია ღიაა Kate-ში."

#: deploymentplugin.cpp:596
#, kde-format
msgid "No deployable files were selected."
msgstr "განლაგებადი ფაილები არჩეული არაა."

#: deploymentplugin.cpp:602
#, kde-format
msgid "Queued one file for upload."
msgid_plural "Queued %1 files for upload."
msgstr[0] "ასატვირთად რიგშია 1 ფაილი."
msgstr[1] "ასატვირთად რიგშია %1 ფაილი."

#: deploymentplugin.cpp:620 deploymentplugin.cpp:674
#, kde-format
msgid "The remote file is open in Kate."
msgstr "დაშორებული ფაილი გახსნილია Kate-ში."

#: deploymentplugin.cpp:629
#, kde-format
msgid "Uploading %1 to %2"
msgstr "%1 იტვირთება %2-ზე"

#: deploymentplugin.cpp:657
#, kde-format
msgctxt "@action"
msgid "Cancel Deployment Transfers (%1%)"
msgstr "განლაგების გადაცემების გაუქმება (%1%)"

#: deploymentplugin.cpp:697
#, kde-format
msgid "Failed to upload %1: %2"
msgstr "%1-ის ატვირთვა ჩავარდა: %2"

#: deploymentplugin.cpp:699
#, kde-format
msgid "Uploaded %1"
msgstr "%1 ატვირთულია"

#: deploymentplugin.cpp:720
#, kde-format
msgid "Cancelled deployment transfers."
msgstr "განლაგების გადაცემები გაუქმდა."

#: deploymentplugin.cpp:754
#, kde-format
msgid "Not connected"
msgstr "დაკავშირებული არაა"

#: deploymentplugin.cpp:772
#, kde-format
msgid ""
"The SFTP KIO worker is not installed or does not support directory listing."
msgstr ""
"KIO-ის SFTP-ის დამხმარე პროცესი დაყენებული არაა, ან საქაღალდის შემცველობის "
"ჩამოთვლის მარდაჭერა არ აქვს."

#: deploymentplugin.cpp:801
#, kde-format
msgctxt "@action:inmenu"
msgid "Open Remote File"
