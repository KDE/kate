msgstr "대응되는 로컬 파일 열기"

#: deploymentplugin.cpp:905
#, kde-format
msgctxt "@action:inmenu"
msgid "Upload Mapped Local File"
msgstr "대응되는 로컬 파일 업로드"

#: deploymentplugin.cpp:915
#, kde-format
msgctxt "@action:inmenu"
msgid "Copy Remote URL"
msgstr "원격 URL 복사"

#: deploymentplugin.cpp:922
