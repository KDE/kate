#: deploymentconfig.cpp:108
#, kde-format
msgid "deployment must be an object"
msgstr "a implantação deve ser um objeto"

#: deploymentconfig.cpp:123
#, kde-format
msgid "deployment host must not be empty"
msgstr "o host de implantação não deve estar vazio"

#: deploymentconfig.cpp:126 deploymentconfig.cpp:130 deploymentconfig.cpp:193
#, kde-format
msgid "deployment host is invalid"
msgstr "o host de implantação é inválido"

#: deploymentconfig.cpp:139
#, kde-format
msgid "deployment port must be between 1 and 65535"
msgstr "a porta de implantação deve estar entre 1 e 65535"

#: deploymentconfig.cpp:145
#, kde-format
msgid "project base must not be empty"
msgstr "a base do projeto não deve estar vazia"

#: deploymentconfig.cpp:150
#, kde-format
msgid "project base must be an existing directory"
msgstr "a pasta base do projeto deve ser um diretório existente"

#: deploymentconfig.cpp:157
#, kde-format
msgid "deployment localRoot must not contain traversal"
msgstr "o localRoot da implantação não deve conter caminho relativo"

#: deploymentconfig.cpp:165
#, kde-format
msgid ""
"deployment localRoot must be an existing directory inside the project base"
msgstr ""
"o localRoot da implantação deve ser um diretório existente dentro da base do "
"projeto"

#: deploymentconfig.cpp:170
#, kde-format
msgid "deployment remoteRoot must be an absolute path without traversal"
msgstr ""
"o remoteRoot da implantação deve ser um caminho absoluto sem caminho relativo"

#: deploymentconfig.cpp:182
#, kde-format
msgid "deployment exclude entries must be strings"
msgstr "as entradas de exclusão de implantação devem ser strings"

#: deploymentconfig.cpp:187
#, kde-format
msgid "deployment exclude must be a list of strings"
msgstr "a exclusão de implantação deve ser uma lista de strings"

