#: deploymentplugin.cpp:533
#, kde-format
msgid "Open or select a Kate project before configuring deployment."
msgstr "Перед настройкой развёртывания откройте или выберите проект Kate."

#: deploymentplugin.cpp:537
#, kde-format
msgid ""
"Deployment configuration requires a file-backed <filename>.kateproject</"
"filename>."
msgstr ""
"Для конфигурации развёртывания требуется проект на основе файла <filename>."
"kateproject</filename>."

#: deploymentplugin.cpp:553
#, kde-format
msgid "Could not read <filename>%1</filename>."
msgstr "Не удалось прочитать <filename>%1</filename>."

#: deploymentplugin.cpp:561
#, kde-format
msgid "Could not update malformed JSON in <filename>%1</filename>: %2"
msgstr "Не удалось обновить некорректный JSON в <filename>%1</filename>: %2"

#: deploymentplugin.cpp:574
#, kde-format
msgid "Could not write <filename>%1</filename>."
msgstr "Не удалось записать <filename>%1</filename>."

#: deploymentplugin.cpp:581
#, kde-format
msgid "Saved deployment configuration to %1"
msgstr "Конфигурация развёртывания сохранена в %1"

#: deploymentplugin.cpp:595
#, kde-format
msgid "The current document is not a local file."
msgstr "Текущий документ не является локальным файлом."

#: deploymentplugin.cpp:631
#, kde-format
msgid "The file could not be saved before upload."
msgstr "Не удалось сохранить файл перед отправкой."

#: deploymentplugin.cpp:646
#, kde-format
msgid "Deployment is not configured for this project."
msgstr "Развёртывание не настроено для этого проекта."

#: deploymentplugin.cpp:651
#, kde-format
msgid "A deployment transfer is already running."
msgstr "Передача развёртывания уже выполняется."

#: deploymentplugin.cpp:661
#, kde-format
msgid "Cannot upload %1 because its remote version is open in Kate."
msgstr "Не удалось отправить %1: его удалённая версия открыта в Kate."

#: deploymentplugin.cpp:672
#, kde-format
msgid "No deployable files were selected."
msgstr "Не выбрано ни одного файла для развёртывания."

#: deploymentplugin.cpp:678
#, kde-format
msgid "Queued one file for upload."
msgid_plural "Queued %1 files for upload."
msgstr[0] "В очереди на отправку: %1 файл."
msgstr[1] "В очереди на отправку: %1 файла."
msgstr[2] "В очереди на отправку: %1 файлов."
msgstr[3] "В очереди на отправку: %1 файл."

#: deploymentplugin.cpp:696 deploymentplugin.cpp:762
#, kde-format
msgid "The remote file is open in Kate."
msgstr "Удалённый файл открыт в Kate."

#: deploymentplugin.cpp:706
#, kde-format
msgid "Uploading %1 to %2"
msgstr "Отправка %1 на %2"

