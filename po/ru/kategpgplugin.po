#: gpgmeppwrapper.cpp:83
#, kde-format
msgid "Error! No keys found..."
msgstr "Ошибка: ключи не найдены"

#: gpgmeppwrapper.cpp:133 gpgmeppwrapper.cpp:135
#, kde-format
msgid "Error finding key: "
msgstr "Ошибка поиска ключа: "

#: gpgmeppwrapper.cpp:223 gpgmeppwrapper.cpp:225
#, kde-format
msgid "Error in symmetric encryption: "
msgstr "Ошибка симметричного шифрования: "

#: gpgmeppwrapper.cpp:241 gpgmeppwrapper.cpp:243
#, kde-format
msgid "Encryption Failed: "
msgstr "Ошибка шифрования: "

#: kategpgplugin.cpp:70
#, kde-format
msgid "GPG Plugin"
msgstr "Модуль GPG"

#: kategpgplugin.cpp:75
#, kde-format
msgid "GPG Decrypt current document"
msgstr "Расшифровать текущий документ с помощью GPG"

#: kategpgplugin.cpp:76
#, kde-format
msgid "GPG Encrypt current document"
msgstr "Зашифровать текущий документ с помощью GPG"

#: kategpgplugin.cpp:80
#, kde-format
msgid "<b>GPG Plugin Settings</b>"
msgstr "<b>Параметры модуля GPG</b>"

#: kategpgplugin.cpp:83
#, kde-format
msgid "Key ID"
msgstr "Идентификатор ключа"

#: kategpgplugin.cpp:84
#, kde-format
msgid "A search string used to filter keys by available email addresses"
msgstr ""
"Строка поиска для фильтрации ключей по доступным адресам электронной почты"

# BUGME: typo "finerprint" -> "fingerprint" --ayavorsky 2026-10-09
#: kategpgplugin.cpp:87
#, kde-format
msgid "Selected GPG Key finerprint for encryption"
msgstr "Отпечаток выбранного ключа GPG для шифрования"

#: kategpgplugin.cpp:88
#, kde-format
msgid "<b>To: Email address used for encryption</b>"
msgstr "<b>Кому: адрес электронной почты, используемый для шифрования</b>"

#: kategpgplugin.cpp:97
#, kde-format
msgid ""
"Select an email address to which to encrypt.\n"
"Only mail addresses associated with your currently selected\n"
"key fingerprint are available."
msgstr ""
"Выберите адрес электронной почты для шифрования.\n"
"Доступны только адреса почты, связанные с выбранным\n"
"отпечатком ключа."

#: kategpgplugin.cpp:101
#, kde-format
msgid ""
"This is your currently selected GPG key fingerprint that will be used for "
"encryption."
msgstr ""
"Это отпечаток выбранного ключа GPG, который будет использоваться для "
"шифрования."

#: kategpgplugin.cpp:104
#, kde-format
msgid "Enable symmetric encryption"
msgstr "Включить симметричное шифрование"

#: kategpgplugin.cpp:107
#, kde-format
msgid "Show only keys for which a private key is available"
msgstr "Показывать только ключи, для которых доступен закрытый ключ"

#: kategpgplugin.cpp:110
#, kde-format
msgid "Hide Expired Keys"
msgstr "Скрывать просроченные ключи"

#: kategpgplugin.cpp:223
#, kde-format
msgid "  Decrypted  "
msgstr "  Расшифровано  "

#: kategpgplugin.cpp:229
#, kde-format
msgid "  Encrypted  "
msgstr "  Зашифровано  "

#: kategpgplugin.cpp:320 kategpgplugin.cpp:451
#, kde-format
msgid "Error Decrypting Text! No fingerprint selected..."
msgstr "Ошибка расшифровки текста: не выбран отпечаток ключа"

#: kategpgplugin.cpp:326 kategpgplugin.cpp:456
#, kde-format
msgid ""
"Error Decrypting Text!\n"
"No matching fingerprint found!\n"
"Or this is not a GPG encrypted text..."
msgstr ""
"Ошибка расшифровки текста.\n"
"Подходящий отпечаток ключа не найден,\n"
"либо текст не зашифрован с помощью GPG."

#: kategpgplugin.cpp:334 kategpgplugin.cpp:464
#, kde-format
msgid "Error Decrypting Text!\n"
msgstr "Ошибка расшифровки текста.\n"

#: kategpgplugin.cpp:416 kategpgplugin.cpp:503
#, kde-format
msgid ""
"Error Encrypting Text!\n"
"No fingerprint selected..."
msgstr ""
"Ошибка шифрования текста.\n"
"Не выбран отпечаток ключа."

#: kategpgplugin.cpp:423 kategpgplugin.cpp:547
#, kde-format
msgid "Error Encrypting Text! No Matching Fingerprint found...\n"
msgstr "Ошибка шифрования текста: подходящий отпечаток ключа не найден.\n"

#: kategpgplugin.cpp:427 kategpgplugin.cpp:551
#, kde-format
msgid "Error Encrypting Text!"
msgstr "Ошибка шифрования текста."

#: kategpgplugin.cpp:443 kategpgplugin.cpp:490
#, kde-format
msgid "Error! No views available..."
msgstr "Ошибка: нет доступных представлений"

#: kategpgplugin.cpp:447
#, kde-format
msgid "Error Decrypting Text! Document is empty..."
msgstr "Ошибка расшифровки текста: документ пуст"

#: kategpgplugin.cpp:495
#, kde-format
msgid "Error Encrypting Text! No document available..."
msgstr "Ошибка шифрования текста: нет документа"

#: kategpgplugin.cpp:499
#, kde-format
msgid "Error Encrypting Text! Document is empty..."
msgstr "Ошибка шифрования текста: документ пуст"

#: kategpgplugin.cpp:507
#, kde-format
msgid ""
"Attempted double encryption detected! Encrypting twice is disabled for now..."
msgstr ""
"Обнаружена попытка повторного шифрования. Двойное шифрование пока не "
"поддерживается."

#: kategpgplugin.cpp:528
#, kde-format
msgid "Save Encrypted File As"
msgstr "Сохранить зашифрованный файл как"

#: kategpgplugin.cpp:530
#, kde-format
msgid "GPG Files (*.gpg *.asc)"
msgstr "Файлы GPG (*.gpg *.asc)"

#: kategpgplugin.cpp:619
#, kde-format
msgid "Key Fingerprint"
msgstr "Отпечаток ключа"

#: kategpgplugin.cpp:619
#, kde-format
msgid "Creation Date"
msgstr "Дата создания"

#: kategpgplugin.cpp:619
#, kde-format
msgid "Expiry Date"
msgstr "Срок действия"

#: kategpgplugin.cpp:619
#, kde-format
msgid "Key Length"
msgstr "Длина ключа"

#: kategpgplugin.cpp:619
#, kde-format
msgid "User IDs"
msgstr "Идентификаторы пользователей"
