#: deploymentplugin.cpp:467
#, kde-format
msgid "Open or select a Kate project before configuring deployment."
msgstr "Preden konfigurirate namestitev, odprite ali izberite projekt Kate."

#: deploymentplugin.cpp:472
#, kde-format
msgid ""
"Deployment configuration requires a file-backed <filename>.kateproject</"
"filename>."
msgstr ""
"Konfiguracija namestitve zahteva datoteko <filename>.kateproject</filename>."

#: deploymentplugin.cpp:487
#, kde-format
msgid "Could not read <filename>%1</filename>."
msgstr "Datoteke <filename>%1</filename> ni bilo mogoče prebrati."

#: deploymentplugin.cpp:493
#, kde-format
msgid "Could not update malformed JSON in <filename>%1</filename>: %2"
msgstr ""
"Nepravilno oblikovanega JSON-a v <filename>%1</filename> ni bilo mogoče "
"posodobiti: %2"

#: deploymentplugin.cpp:502
#, kde-format
msgid "Could not write <filename>%1</filename>."
msgstr "Datoteke <filename>%1</filename> ni bilo mogoče zapisati."

#: deploymentplugin.cpp:508
#, kde-format
msgid "Saved deployment configuration to %1"
msgstr "Konfiguracija namestitve je shranjena v %1"

#: deploymentplugin.cpp:520
#, kde-format
msgid "The current document is not a local file."
msgstr "Trenutni dokument ni lokalna datoteka."

#: deploymentplugin.cpp:555
#, kde-format
msgid "The file could not be saved before upload."
msgstr "Datoteke pred prenosom ni bilo mogoče shraniti."

#: deploymentplugin.cpp:571
#, kde-format
msgid "Deployment is not configured for this project."
msgstr "Za ta projekt namestitev ni konfigurirana."

#: deploymentplugin.cpp:575
#, kde-format
msgid "A deployment transfer is already running."
msgstr "Prenos namestitve že poteka."

#: deploymentplugin.cpp:586
#, kde-format
msgid "Cannot upload %1 because its remote version is open in Kate."
msgstr ""
"Datoteke %1 ni mogoče prenesti, ker je njena oddaljena različica odprta v "
"programu Kate."

#: deploymentplugin.cpp:596
#, kde-format
msgid "No deployable files were selected."
msgstr "Izbrana ni bila nobena datoteka za namestitev."

#: deploymentplugin.cpp:602
#, kde-format
msgid "Queued one file for upload."
msgid_plural "Queued %1 files for upload."
msgstr[0] "%1 datotek je v čakalni vrsti za prenos tja."
msgstr[1] "%1 datoteka je v čakalni vrsti za prenos tja."
msgstr[2] "%1 datoteki sta v čakalni vrsti za prenos tja."
msgstr[3] "%1 datoteke so v čakalni vrsti za prenos tja."

#: deploymentplugin.cpp:620 deploymentplugin.cpp:674
#, kde-format
msgid "The remote file is open in Kate."
msgstr "Oddaljena datoteka je odprta v programu Kate."

#: deploymentplugin.cpp:629
#, kde-format
