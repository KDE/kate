#: kateconsole.cpp:123 kateconsole.cpp:155 kateconsole.cpp:796
#, kde-format
msgid "Terminal"
msgstr "Терминал"

#: kateconsole.cpp:164
#, kde-format
msgctxt "@action"
msgid "&Pipe to Terminal"
msgstr "&Проследи у терминал"

#: kateconsole.cpp:168
#, kde-format
msgctxt "@action"
msgid "S&ynchronize Terminal with Current Document"
msgstr "&Синхронизуј терминал са документом"

#: kateconsole.cpp:172
#, kde-format
msgctxt "@action"
msgid "Run Current Document"
msgstr "Изврши документ"

#: kateconsole.cpp:177 kateconsole.cpp:580
#, kde-format
msgctxt "@action"
msgid "S&how Terminal Panel"
msgstr "Прикажи панел &терминала"

#: kateconsole.cpp:183
#, kde-format
msgctxt "@action"
msgid "&Focus Terminal Panel"
msgstr "&Фокусирај панел терминала"

#: kateconsole.cpp:189
#, kde-format
msgctxt "@action"
msgid "&Split Terminal Vertically"
msgstr "Подели терминал &усправно"

#: kateconsole.cpp:194
#, kde-format
msgctxt "@action"
msgid "&Split Terminal Horizontally"
msgstr "Подели терминал &водоравно"

#: kateconsole.cpp:199
#, kde-format
msgctxt "@action"
msgid "&New Terminal Tab"
msgstr "&Нови језичак терминала"

#: kateconsole.cpp:363
#, kde-format
msgid ""
"Konsole not installed. Please install konsole to be able to use the terminal."
msgstr ""
"Конзола није инсталирана. Инсталирајте Конзолу да бисте могли да користите "
"терминал."

#: kateconsole.cpp:439
#, kde-format
msgid ""
"Do you really want to pipe the text to the console? This will execute any "
"contained commands with your user rights."
msgstr ""
"Желите ли заиста да проследите текст у конзолу? Тиме ће се извршити свака "
"садржана наредба, уз ваше корисничке дозволе."

#: kateconsole.cpp:440
#, kde-format
msgid "Pipe to Terminal?"
msgstr "Проследити у терминал?"

#: kateconsole.cpp:441
#, kde-format
msgid "Pipe to Terminal"
msgstr "Проследи у терминал"

#: kateconsole.cpp:509
#, kde-format
msgid "Not a local file: '%1'"
msgstr "Није локални фајл: %1"

#: kateconsole.cpp:542
#, kde-format
msgid ""
"Do you really want to Run the document ?\n"
"This will execute the following command,\n"
"with your user rights, in the terminal:\n"
"'%1'"
msgstr ""
"Желите ли заиста да извршите овај документ? Извршила би се следећа наредба, "
"под вашим корисничким дозволама, у терминалу:\n"
"%1"

#: kateconsole.cpp:549
#, kde-format
msgid "Run in Terminal?"
msgstr "Извршити у терминалу?"

#: kateconsole.cpp:550
#, kde-format
msgid "Run"
msgstr "Изврши"

#: kateconsole.cpp:582
#, kde-format
msgctxt "@action"
msgid "&Hide Terminal Panel"
msgstr "Сакриј панел &терминала"

#: kateconsole.cpp:590
#, kde-format
msgid "Defocus Terminal Panel"
msgstr "Дефокусирај панел терминала"

#: kateconsole.cpp:591 kateconsole.cpp:592
#, kde-format
msgid "Focus Terminal Panel"
msgstr "Фокусирај панел терминала"

#: kateconsole.cpp:704
#, kde-format
msgid "Terminal Synchronization Mode"
msgstr "Режим синхронизације терминала"

#: kateconsole.cpp:707
#, kde-format
msgid "&Don't synchronize terminal tab with current document"
msgstr "&Не синхронизуј језичак терминала са текућим документом"

#: kateconsole.cpp:710
#, kde-format
msgid ""
"&Automatically synchronize the current terminal tab with the current "
"document when possible"
msgstr ""
"&Аутоматски синхронизуј текући језичак терминала са текућим документом када "
"је могуће"

#: kateconsole.cpp:713
#, kde-format
msgid ""
"&Automatically create a terminal tab for the directory of the current "
"document and switch to it"
msgstr ""
"Аутоматски направи &језичак терминала за фасциклу текућег документа и пређи "
"на њега"

# >> @title:window
#: kateconsole.cpp:720 kateconsole.cpp:741
#, kde-format
msgid "Run in terminal"
msgstr "Извршавање у терминалу"

#: kateconsole.cpp:722
#, kde-format
msgid "&Remove extension"
msgstr "&Уклони наставак"

#: kateconsole.cpp:727
#, kde-format
msgid "Prefix:"
msgstr "Префикс:"

#: kateconsole.cpp:735
#, kde-format
msgid "&Show warning next time"
msgstr "&Упозори следећи пут"

#: kateconsole.cpp:737
#, kde-format
msgid ""
"The next time '%1' is executed, make sure a warning window will pop up, "
"displaying the command to be sent to terminal, for review."
msgstr ""
"Следећи пут када „%1“ треба да се изврши, појавиће се прозор са упозорењем, "
"где ће бити дат преглед наредбе која се шаље у терминал."

# literal-segment: EDITOR
#: kateconsole.cpp:748
#, kde-format
msgid "Set &EDITOR environment variable to 'kate -b'"
msgstr "Постави променљиву &окружења $EDITOR на „kate -b“"

#: kateconsole.cpp:751
#, kde-format
msgid ""
"Important: The document has to be closed to make the console application "
"continue"
msgstr "Важно: документ мора бити затворен да би се конзолни програм наставио."

#: kateconsole.cpp:754
#, kde-format
msgid "Hide Konsole on pressing 'Esc'"
msgstr "Сакриј Конзолу при притиску на „Esc“"

#: kateconsole.cpp:757
#, kde-format
msgid ""
"This may cause issues with terminal apps that use Esc key, for e.g., vim. "
"Add these apps in the input below (Comma separated list)"
msgstr ""
"Ово може да смета терминалским програмима који користе тастер Esc, нпр. Вим. "
"Додајте те програме у поље испод (списак раздвојен запетама)"

#: kateconsole.cpp:801
#, kde-format
msgid "Terminal Settings"
msgstr "Поставке терминала"

