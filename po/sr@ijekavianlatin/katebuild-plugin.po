#: plugin_katebuild.cpp:505
#, kde-format
msgid "Build Information"
msgstr "Podaci o gradnji"

#: plugin_katebuild.cpp:764
#, kde-format
msgid "There is no file or directory specified for building."
msgstr "Nije zadat fajl ili fascikla za gradnju."

#: plugin_katebuild.cpp:768
#, kde-format
msgid ""
"The file \"%1\" is not a local file. Non-local files cannot be compiled."
msgstr "Fajl ‘%1’ nije lokalni. Udaljeni fajlovi se ne mogu kompilovati."

#: plugin_katebuild.cpp:844
#, kde-format
msgid "Create directory"
msgstr "Stvaranje fascikle"

#: plugin_katebuild.cpp:847
#, kde-format
msgid ""
"The configured working directory <b>%1</b> for the targetset <b>%2</b> does "
"not exist.<br><br>Create the directory?"
msgstr ""
"Podešena radna fascikla <b>%1</b> za skup ciljeva <b>%2</b> ne postoji.<br/"
"><br/>Napraviti fasciklu?"

#: plugin_katebuild.cpp:855
#, kde-format
msgid "Failed to create the directory <b>%1</b>"
msgstr "Ne mogu da napravim fasciklu <b>%1</b>"

#: plugin_katebuild.cpp:880
#, kde-format
msgid "Failed to run \"%1\". exitStatus = %2"
msgstr "Neuspjelo izvršavanje „%1“. Izlazno stanje: %2"

#: plugin_katebuild.cpp:896
#, kde-format
msgid "Building <b>%1: %2</b> cancelled"
msgstr "Gradnja <b>%1: %2</b> otkazana"

#: plugin_katebuild.cpp:1002
#, kde-format
msgid "Did not find a compile_commands.json for file \"%1\". "
msgstr "Nije nađen fajl compile_commands.json za fajl „%1“. "

#: plugin_katebuild.cpp:1015
#, kde-format
msgid "Did not find a compile command for file \"%1\" in \"%2\". "
msgstr "Nije nađena naredba kompilovanja za fajl „%1“ u „%2“. "

#: plugin_katebuild.cpp:1034
#, kde-format
msgid ""
"Cannot make \"%f\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Ne mogu da izvršim zamjenu „%f“. Nema otvorenog fajla ili je tekući fajl "
"neimenovan!"

#: plugin_katebuild.cpp:1038
#, kde-format
msgid ""
"Cannot make \"%d\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Ne mogu da izvršim zamjenu „%d“. Nema otvorenog fajla ili je tekući fajl "
"neimenovan!"

#: plugin_katebuild.cpp:1042
#, kde-format
msgid ""
"Cannot make \"%n\" substitution. No open file or the current file is "
"untitled!"
msgstr ""
"Ne mogu da izvršim zamjenu „%n“. Nema otvorenog fajla ili je tekući fajl "
"neimenovan!"

#: plugin_katebuild.cpp:1053
#, kde-format
msgid "Cannot make project substitution (%B). No open project!"
msgstr "Ne mogu da izvršim zamjenu projekta (%B). Nema otvorenog projekta!"

#: plugin_katebuild.cpp:1066
#, kde-format
msgid "Already building..."
msgstr "Već se gradi..."

#: plugin_katebuild.cpp:1104
#, kde-format
msgid ""
"Cannot execute: %1: %2 No working directory set.\n"
"There is no local file or directory specified for building."
msgstr ""
"Ne mogu da izvršim: %1: %2 Radna fascikla nije postavljena.\n"
"Nije zadat lokalni fajl ili fascikla za gradnju."

#: plugin_katebuild.cpp:1225
#, kde-format
msgid "Building target <b>%1: %2</b> ..."
msgstr "Gradim cilj <b>%1: %2</b>..."

#: plugin_katebuild.cpp:1262
#, kde-format
msgid ""
"Cannot load targets, the file %1 does not contain a proper CMAKE_COMMAND "
"entry !"
msgstr ""
"Ne mogu da učitam ciljeve, fajl %1 ne sadrži ispravan unos CMAKE_COMMAND!"

#: plugin_katebuild.cpp:1275
#, kde-format
msgid "Could not write CMake File API query files for build directory %1 !"
msgstr ""
"Ne mogu da upišem fajlove upita za File API CMakea za fasciklu gradnje %1!"

#: plugin_katebuild.cpp:1281
#, kde-format
msgid "Could not run CMake (%2) for build directory %1 !"
msgstr "Ne mogu da pokrenem CMake (%2) za fasciklu gradnje %1!"

#: plugin_katebuild.cpp:1290
#, kde-format
msgid ""
"Generating CMake File API reply files for build directory %1 failed (using "
"%2) !"
msgstr ""
"Ne mogu da generišem fajlove odgovora za File API CMakea za fasciklu gradnje "
"%1 (pomoću %2)!"

#: plugin_katebuild.cpp:1415
#, kde-format
msgid "Build plugin wants to execute program"
msgstr "Priključak za gradnju želi da izvrši program"

#: plugin_katebuild.cpp:1418
#, kde-format
msgid ""
"The Kate build plugin needs to execute an external command to read the "
"targets from the build tree.<br><br>The full command line is:<br><br><b>%1</"
"b><br><br>Proceed and allow to run this command ?<br><br>The choice can be "
"altered via the config page of the plugin."
msgstr ""
"Katein priključak za gradnju treba da izvrši spoljašnju naredbu da bi "
"pročitao ciljeve iz stabla gradnje.<br/><br/>Puna komandna linija je:<br/"
"><br/><b>%1</b><br/><br/>Nastaviti i dozvoliti izvršavanje ove naredbe?<br/"
"><br/>Izbor se može izmijeniti na stranici postave priključka."

