"Fascikle za pretragu dodajte kao putanje razdvojene sa „;“"

#: TargetHtmlDelegate.cpp:102
#, kde-format
msgid ""
"Use:\n"
"\"%B\" for project base directory\n"
"\"%b\" for name of project base directory"
msgstr ""
"Zadajte:\n"
"„%B“ za osnovnu fasciklu projekta\n"
"„%b“ za ime osnovne fascikle projekta"

#: TargetHtmlDelegate.cpp:106
#, kde-format
msgid ""
"Use:\n"
"\"%f\" for current file\n"
"\"%d\" for directory of current file\n"
"\"%n\" for current file name without suffix\n"
"\"%B\" for current project's base directory\n"
"\"%w\" for the working directory of the target"
msgstr ""
"Zadajte:\n"
"„%f“ za tekući fajl\n"
"„%d“ za fasciklu tekućeg fajla\n"
"„%n“ za ime tekućeg fajla bez nastavka\n"
"„%B“ za osnovnu fasciklu tekućeg projekta\n"
"„%w“ za radnu fasciklu cilja"

