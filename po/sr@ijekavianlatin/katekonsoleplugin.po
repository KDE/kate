msgctxt "@action"
msgid "Run Current Document"
msgstr "Izvrši dokument"

#: kateconsole.cpp:177 kateconsole.cpp:580
#, kde-format
msgctxt "@action"
msgid "S&how Terminal Panel"
msgstr "Prikaži panel &terminala"

#: kateconsole.cpp:183
