#: tabswitcher.cpp:57
#, kde-format
msgid "Document Switcher"
msgstr "Mjenjač dokumenata"

#: tabswitcher.cpp:102
#, kde-format
msgid "Last Used Views"
msgstr "Posljednje korišćeni prikazi"

#: tabswitcher.cpp:105
#, kde-format
msgid "Opens a list to walk through the list of last used views."
msgstr "Otvara spisak za kretanje kroz posljednje korišćene prikaze."

#: tabswitcher.cpp:106 tabswitcher.cpp:114
#, kde-format
msgid "Walk through the list of last used views"
msgstr "Kretanje kroz posljednje korišćene prikaze"

#: tabswitcher.cpp:110
#, kde-format
msgid "Last Used Views (Reverse)"
msgstr "Posljednje korišćeni prikazi (obratno)"

#: tabswitcher.cpp:113
#, kde-format
msgid "Opens a list to walk through the list of last used views in reverse."
msgstr "Otvara spisak za obratno kretanje kroz posljednje korišćene prikaze."

#: tabswitcher.cpp:118
#, kde-format
msgid "Close View"
msgstr "Zatvori prikaz"

#: tabswitcher.cpp:121 tabswitcher.cpp:122
#, kde-format
msgid "Closes the selected view in the list of last used views."
msgstr "Zatvara izabrani prikaz u spisku posljednje korišćenih prikaza."

