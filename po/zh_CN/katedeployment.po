msgstr "本地根目录："

#: deploymentplugin.cpp:142
#, kde-format
msgctxt "@label:textbox"
msgid "Remote root:"
msgstr "远程根目录："

#: deploymentplugin.cpp:143
#, kde-format
msgctxt "@label:textbox"
msgid "Exclude:"
msgstr "排除："

